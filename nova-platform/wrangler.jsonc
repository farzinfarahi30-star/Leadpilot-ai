{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-platform",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "NOVA_STATE", "class_name": "NovaState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NovaState"] }
  ],
  "observability": { "enabled": true }
}
