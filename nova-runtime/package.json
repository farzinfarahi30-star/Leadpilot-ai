{
  "name": "nova-runtime",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/worker.mjs",
    "smoke": "node src/smoke.mjs",
    "company:takeover": "node test/company-takeover.test.mjs",
    "device:smoke": "node ../nova-device/src/smoke.mjs",
    "device:supervise": "node ../nova-device/src/supervisor.mjs",
    "device:agent": "NOVA_LOCAL_DAEMON=true NOVA_DEVICE_CONTROL=true node src/worker.mjs",
    "desktop-commander:doctor": "node -e \"import('./src/desktop-commander-mcp.mjs').then(async m=>{if(!m.desktopCommanderConfigured()){console.log(JSON.stringify({configured:false,reason:'DESKTOP_COMMANDER_OAUTH_TOKEN not configured'}));return;}try{console.log(JSON.stringify(await m.desktopCommanderHealth()))}catch(e){console.log(JSON.stringify({configured:true,connected:false,error:String(e)}));}}).catch(e=>{console.log(JSON.stringify({configured:false,error:String(e)}))})\"",
    "chain:preflight": "node -e \"import('./src/nova-chain-controller.mjs').then(async m=>console.log(JSON.stringify(await m.novaChainPreflight({requireDeployerAddress:true}),null,2))).catch(e=>{console.error(e.message);process.exitCode=1})\"",
    "chain:deploy:sepolia": "node -e \"import('./src/nova-chain-controller.mjs').then(async m=>console.log(JSON.stringify(await m.deployNovaTokenSepolia(),null,2))).catch(e=>{console.error(e.message);process.exitCode=1})\"",
    "alchemy:doctor": "node -e \"import('./src/alchemy.mjs').then(async m=>console.log(JSON.stringify({resources:m.alchemySepoliaResources(),chainId:await m.alchemySepoliaChainId(),blockNumber:await m.alchemySepoliaBlockNumber()},null,2))).catch(e=>{console.error(e.message);process.exitCode=1})\"",
    "crypto:doctor": "node -e \"import('./src/crypto-capabilities.mjs').then(async m=>console.log(JSON.stringify(m.novaCryptoDoctor(),null,2))).catch(e=>{console.error(e.message);process.exitCode=1})\"",
    "crypto:chain-doctor": "node -e \"import('./src/crypto-capabilities.mjs').then(async m=>console.log(JSON.stringify(await m.novaCryptoChainDoctor(),null,2))).catch(e=>{console.error(e.message);process.exitCode=1})\"",
    "crypto:takeover": "node test/crypto-company-takeover.test.mjs"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.56.0",
    "playwright": "^1.55.0"
  }
}
